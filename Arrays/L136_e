class Solution {
public:
    int singleNumber(vector<int>& nums) {
        int n=nums.size();
        sort(nums.begin(),nums.end());
        int exp=0;
        int sum=0;
        for(int i=0;i<n;i++){
            exp+=nums[i];
            if(i+1<n&&nums[i]==nums[i+1]){
                sum+=2*nums[i];
                
            }
        }
        return exp-sum;
    }
};
