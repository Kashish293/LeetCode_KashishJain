class Solution {
public:
    int thirdMax(vector<int>& nums) {
        sort(nums.rbegin(),nums.rend());
        int n=nums.size();
        vector<int>ans;
        for(int i=0;i<n;i++){
                    if(i+1<n&&nums[i]==nums[i+1]) continue;
                    ans.push_back(nums[i]);
        }
        int m=ans.size();
        if(m<3) return ans[0];
        return ans[2];
    }
};
