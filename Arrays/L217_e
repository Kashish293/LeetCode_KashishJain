class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        int n=nums.size();
        sort(nums.begin(),nums.end());
        bool flag=false;
        for(int i=0;i<n;i++){
            if(i>0&&nums[i]==nums[i-1]){
                flag=true;
                break;
            }
        }
        return flag;
    }
};
