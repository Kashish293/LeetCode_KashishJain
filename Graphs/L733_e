class Solution {
public:
    void dfs(int row,int col,vector<vector<int>>&ans,vector<vector<int>>&image,int color,int initial){
        int n=image.size();
        int m=image[0].size();
        ans[row][col]=color;
        int dr[]={-1,0,1,0};
        int dc[]={0,-1,0,1};
        for(int i=0;i<4;i++){
            int nr=row+dr[i];
            int nc=col+dc[i];
            if(nr>=0&&nr<n&&nc>=0&&nc<m&&image[nr][nc]==initial&&ans[nr][nc]!=color){
                dfs(nr,nc,ans,image,color,initial);
            }
        }
    }
    vector<vector<int>> floodFill(vector<vector<int>>& image, int sr, int sc, int color) {
        int initial=image[sr][sc];
        vector<vector<int>>ans=image;
        dfs(sr,sc,ans,image,color,initial);
        return ans;
    }
};
